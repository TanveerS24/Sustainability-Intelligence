# Sustainability Intelligence - Environment Variables Configuration

# Server Port
PORT=4000

# Client Port (for Vite dev server)
VITE_PORT=3000

# Client API Base URL
VITE_API_URL=http://localhost:4000

# Data Directories and Database File
RAW_DATA_DIR=./server/data/raw
DB_PATH=./server/data/sustainability.db

# Pipeline Sampling and Date Window
SAMPLE_HOUSEHOLDS=300
DATE_FROM=2013-01-01
DATE_TO=2013-12-31
MIN_READINGS_PER_HH=1000

# Time-of-Use Peak Window (24h clock, inclusive start, exclusive end)
PEAK_START_HOUR=16
PEAK_END_HOUR=20

# Data Mining Parameters
K_MIN=2
K_MAX=8
DBSCAN_EPS=
DBSCAN_MIN_PTS=5
RANDOM_SEED=42

# Association Rule Mining Parameters
MIN_SUPPORT=0.05
MIN_CONFIDENCE=0.6
MAX_RULES_PER_CLUSTER=25

# Sustainability / Carbon Accounting
# UK average grid carbon intensity (kg CO2 / kWh). Note: 0.207 kg CO2/kWh benchmark.
EMISSION_FACTOR_KG_PER_KWH=0.207

# Weather / Temperature Discretisation Thresholds (Celsius)
TEMP_COLD_MAX=8
TEMP_MILD_MAX=16

# RAG Knowledge-Augmented Advisor
# Optional: Anthropic API key for LLM generation. When unset, deterministic template mode is used.
ANTHROPIC_API_KEY=
RAG_TOP_K=5
